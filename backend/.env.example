# Django Application Settings
DEBUG=True
SECRET_KEY=django-insecure-initial-development-key-change-in-prod
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS Configuration (Origins permitted to call API)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Connection
# Set DATABASE_URL to your PostgreSQL instance:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/task_management
# Note: If DATABASE_URL is left unset or blank, the service automatically defaults to local SQLite3 for instant testing.
DATABASE_URL=
